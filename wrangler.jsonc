{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "law-firm",
    "compatibility_date": "2025-01-01",
    "compatibility_flags": ["nodejs_compat"],
    "main": "./.output/server/index.mjs",
    "assets": {
        "directory": "./.output/public",
        "binding": "ASSETS",
        "html_handling": "none",
    },
    "routes": [
        { "pattern": "ridwanco.com", "custom_domain": true },
        { "pattern": "www.ridwanco.com", "custom_domain": true },
    ],
    "vars": {
        "NUXT_PUBLIC_SITE_URL": "https://ridwanco.com",
    },
}
