{
    "name": "law-firm",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "cf:preview": "wrangler dev",
        "cf:deploy": "npm run build && wrangler deploy",
        "postinstall": "nuxt prepare && prisma generate",
        "prepare": "husky",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "audit:ci": "npm audit --audit-level=high",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:studio": "prisma studio",
        "verify:all": "npm run lint && npm run test"
    },
    "dependencies": {
        "@nuxt/fonts": "^0.14.0",
        "@nuxt/icon": "^2.3.1",
        "@nuxt/image": "^2.0.0",
        "@nuxtjs/sitemap": "^8.3.0",
        "@nuxtjs/tailwindcss": "^6.14.0",
        "@prisma/client": "^7.9.1",
        "@react-email/render": "^2.1.0",
        "eslint": "^10.7.0",
        "nuxt": "^4.5.2",
        "resend": "^6.18.0",
        "vue": "^3.5.40",
        "vue-router": "^5.2.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@nuxt/eslint": "^1.16.0",
        "@nuxt/test-utils": "^4.0.3",
        "@vue/test-utils": "^2.4.11",
        "eslint-config-prettier": "^10.1.8",
        "happy-dom": "^20.11.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.1.0",
        "prettier": "^3.9.5",
        "prisma": "^6.19.3",
        "vitest": "^4.1.10",
        "wrangler": "^4.113.0"
    },
    "lint-staged": {
        "*.{js,mjs,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    }
}
